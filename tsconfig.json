{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "module": "commonjs",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": ["src", "knexfile.ts", "migrations/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
